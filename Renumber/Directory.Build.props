<Project>

  <!-- MSBuild stops at the first Directory.Build.props it finds, so the brand
       wiring one level up has to be pulled in by hand. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup>
    <!-- The SDK only excludes the CURRENT build's obj\ and bin\ from the default
         item globs. With per-framework subfolders that leaves the other half's
         obj\ in scope, and its generated AssemblyInfo.cs gets compiled too —
         which fails with CS0579 duplicate-attribute errors. Exclude both trees.
         This has to live here rather than in the .csproj: the globs are expanded
         while the SDK props are still being evaluated. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
